# GreenCity AI Environment Configuration Example

# Application
APP_NAME="GreenCity AI"
APP_ENV=development
SECRET_KEY="greencity_ai_production_super_secret_jwt_key_change_in_prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
# Production (PostgreSQL + PostGIS): postgresql://postgres:postgres@localhost:5432/greencity_db
# Local SQLite fallback for fast dev: sqlite:///./greencity.db
DATABASE_URL="sqlite:///./greencity.db"
POSTGIS_ENABLED=true

# Redis & Worker
REDIS_URL="redis://localhost:6379/0"

# Storage
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"

# API & Web URLs
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
API_PORT=8000

# Google Maps Platform (Routes API)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
